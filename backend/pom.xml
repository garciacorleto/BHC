
<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<!-- Versión del modelo de configuración de Maven. -->
	<modelVersion>4.0.0</modelVersion>

	<!--
        Configuración principal heredada de Spring Boot.
        Gestiona versiones compatibles de dependencias y plugins.
    -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>

	<!-- Identificación del proyecto BHC. -->
	<groupId>com.bhc</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<!-- Nombre y descripción del backend. -->
	<name>BHC Backend</name>
	<description>API REST para la gestión de camiones y reservas de BHC</description>

	<!-- Versión de Java utilizada para compilar el proyecto. -->
	<properties>
		<java.version>25</java.version>
		<maven.compiler.release>25</maven.compiler.release>
	</properties>

	<!-- Dependencias necesarias para ejecutar la aplicación. -->
	<dependencies>

		<!--
            Spring Web MVC:
            permite crear controladores REST y gestionar
            peticiones HTTP como GET, POST y PATCH.
        -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!--
            Herramientas para realizar pruebas del backend.
            Solo se utilizan durante la fase de test.
        -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
            Base de datos H2.
            Se utiliza durante la ejecución de la aplicación.
        -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
            Spring Data JPA:
            permite trabajar con entidades y repositorios
            para almacenar y consultar datos mediante Hibernate.
        -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

	</dependencies>

	<!-- Configuración de plugins de construcción. -->
	<build>
		<plugins>

			<!-- Plugin de Spring Boot para Maven.
			Permite ejecutar y empaquetar la aplicación. -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

		</plugins>
	</build>

</project>
